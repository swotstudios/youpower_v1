# Credenziali Odoo usate solo dalla serverless function /api/lead.
# Copia questo file in .env (che NON viene versionato) e inserisci i valori.
# Su Vercel vanno impostate come Environment Variables del progetto.

ODOO_URL=https://odoo.youpower.ch
ODOO_DB=youpower
ODOO_UID=21
ODOO_API_KEY=

# Notifica inviata a YouPower a ogni richiesta. Parte dallo stesso Odoo
# (modello mail.mail), quindi non servono credenziali SMTP. Entrambe sono
# facoltative: senza, valgono i default scritti qui sotto.
LEAD_MAIL_TO=info@youpower.ch
LEAD_MAIL_FROM=YouPower <noreply@youpower.ch>

# Invio della notifica via Resend (canale principale).
# Se manca, la notifica ripiega sul chatter di Odoo.
RESEND_API_KEY=
